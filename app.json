{
  "expo": {
    "name": "KaysPay",
    "slug": "KaysPay",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon-green.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "supabase.co": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTP": false,
              "NSExceptionRequiresForwardSecrecy": true
            },
            "expo.dev": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTP": false,
              "NSExceptionRequiresForwardSecrecy": true
            }
          }
        }
      }
    },
    "android": {
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.WRITE_CONTACTS",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon-green.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kayspay.app",
      "permissions": [
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/icon-green.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cf76d478-2ceb-4f07-8e52-9864d94437fa"
    },
    "plugins": [
      "expo-asset",
      "expo-notifications",
      "./plugins/withAndroidNetworkSecurity.js",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow KaysPay to access your contacts so you can send airtime and data without typing numbers."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-screen.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#1A5C3A"
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cf76d478-2ceb-4f07-8e52-9864d94437fa"
      }
    },
    "owner": "ifekwe"
  }
}
